{
  "name": "rodaje",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env app/server.mjs",
    "start:lan": "RODAJE_LAN=1 node --env-file-if-exists=.env app/server.mjs",
    "check:proyectos": "node scripts/proyecto-check.mjs --all",
    "test": "node --import ./test/setup.mjs --test test/*.test.mjs",
    "build:ui": "esbuild app/app.source.js --bundle --format=esm --external:./workflow.mjs --external:./stage.js --outfile=app/app.js --banner:js=\"// Generated from app.source.js. Run npm run build:ui after editing UI sources.\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fal-ai/client": "^1.10.1",
    "dompurify": "^3.4.15",
    "esbuild": "^0.28.2",
    "marked": "^18.0.13",
    "playwright": "^1.55.0",
    "three": "0.180.0"
  }
}
